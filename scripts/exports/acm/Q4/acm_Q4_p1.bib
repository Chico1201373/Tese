@inproceedings{10.1145/3805712.3809631,
author = {Liu, Peiyang and Yan, Qiang and Cui, Ziqiang and Liang, Di and Wang, Xi and Ye, Wei},
title = {Beyond Semantic Relevance: Counterfactual Risk Minimization for Robust Retrieval-Augmented Generation},
year = {2026},
isbn = {9798400725999},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3805712.3809631},
doi = {10.1145/3805712.3809631},
abstract = {Standard Retrieval-Augmented Generation (RAG) systems predominantly rely on semantic relevance as a proxy for utility. However, this assumption collapses in realistic decision-making scenarios where user queries are laden with cognitive biases, such as false premises or confirmation bias. In such cases, maximizing relevance paradoxically promotes the retrieval of sycophantic evidence that reinforces hallucinations, a critical failure we term the "Relevance-Robustness Gap". To bridge this gap, we propose CoRM-RAG (Counterfactual Risk Minimization for RAG), a framework that aligns retrieval with decision safety rather than mere similarity. Grounded in causal intervention, we introduce a Cognitive Perturbation Protocol to simulate user biases during training, which is then distilled into a lightweight Evidence Critic. This scoring module learns to identify documents that possess sufficient evidential strength to steer the model toward correctness despite adversarial query perturbations. Extensive experiments on decision-making benchmarks demonstrate that CoRM-RAG significantly outperforms strong dense retrievers and LLM-based rerankers in adversarial settings, while enabling effective risk-aware abstention through reliable robustness scoring. Our code is available at https://github.com/PeiYangLiu/CoRM-RAG.git.},
booktitle = {Proceedings of the 49th International ACM SIGIR Conference on Research and Development in Information Retrieval},
pages = {1232–1243},
numpages = {12},
keywords = {retrieval-augmented generation, robustness, uncertainty estimation},
location = {Melbourne, VIC, Australia},
series = {SIGIR '26}
}

@inproceedings{10.1145/3793638.3793643,
author = {Farhad, Moomal and Masud, Mohammad and Abdul Rasheed, Ashika Sameem and Musthfa, Namya},
title = {How Linguistic Variation Shapes Hallucination Risk in Large Language Models: A Psychometric Perspective},
year = {2026},
isbn = {9798400722820},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3793638.3793643},
doi = {10.1145/3793638.3793643},
abstract = {Large Language Models (LLMs) are increasingly used in clinical decision support, patient communication, and digital medical information services. However, hallucinations, which are confident yet incorrect medical statements, pose serious safety and security risks. These risks become even greater when they are triggered by variations in a user’s linguistic style. This study systematically investigates how tone and grammatical quality shape hallucination behavior in medical LLMs using the medical subset of the publicly available TruthfulQA dataset. We generate 15 controlled prompt variants per question based on tone and grammar variations, and evaluate two models, DeepSeek-V3 and Med42-8B, using GPT-4.1-mini as an external judge to score correctness, hallucination, harmfulness, abstention, and overconfidence. Drawing inspiration from psychometric testing, each tone grammar prompt variant is treated as an item probing latent susceptibility traits, enabling us to quantify tone sensitivity, robustness to linguistic noise, and vulnerability to pressured prompting. Our results reveal strong tone–grammar interaction effects, showing that DeepSeek-V3 remains stable across all 15 conditions, while Med42-8B exhibits substantial variability. Neutral tone combined with mild grammatical noise yields the highest hallucination rates, while polite tone produces the lowest accuracy and increased abstention and overconfidence, exposing distinct vulnerability profiles. Mixed-effects psychometric modelling further shows that Med42-8B has significantly higher question-level difficulty variance (ICC 27.4\% vs. 10.6\%) and heightened sensitivity to both tone and linguistic noise. Together, these findings establish a psychometric framework for identifying linguistic conditions that increase hallucination risk, offering actionable insights for safer LLM deployment, robust prompt design, and the development of tone-aware safety mechanisms in medical AI systems.},
booktitle = {Proceedings of the 2026 Australasian Information Security Conference},
pages = {38–46},
numpages = {9},
location = {Melbourne, VIC, Australia},
series = {AISC '26}
}

@inproceedings{10.1145/3627673.3679961,
author = {El Hamdani, Rajaa and Bonald, Thomas and Malliaros, Fragkiskos D. and Holzenberger, Nils and Suchanek, Fabian},
title = {The Factuality of Large Language Models in the Legal Domain},
year = {2024},
isbn = {9798400704369},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3627673.3679961},
doi = {10.1145/3627673.3679961},
abstract = {This paper investigates the factuality of large language models (LLMs) as knowledge bases in the legal domain, in a realistic usage scenario: we allow for acceptable variations in the answer, and let the model abstain from answering when uncertain. First, we design a dataset of diverse factual questions about case law and legislation. We then use the dataset to evaluate several LLMs under different evaluation methods, including exact, alias, and fuzzy matching. Our results show that the performance improves significantly under the alias and fuzzy matching methods. Further, we explore the impact of abstaining and in-context examples, finding that both strategies enhance precision. Finally, we demonstrate that additional pre-training on legal documents, as seen with SaulLM, further improves factual precision from 63\% to 81\%.},
booktitle = {Proceedings of the 33rd ACM International Conference on Information and Knowledge Management},
pages = {3741–3746},
numpages = {6},
keywords = {factuality, hallucination, knowledge bases, legal domain, llm},
location = {Boise, ID, USA},
series = {CIKM '24}
}

@inproceedings{10.1145/3772318.3793266,
author = {Gonzalez Penuela, Ricardo E. and Jung, Crescentia and Lin, Sharon and Hu, Ruiying and Azenkot, Shiri},
title = {How Multimodal Large Language Models Support Access to Visual Information: A Diary Study With Blind and Low Vision People},
year = {2026},
isbn = {9798400722783},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772318.3793266},
doi = {10.1145/3772318.3793266},
abstract = {Multimodal large language models (MLLMs) are changing how Blind and Low Vision (BLV) people access visual information. Unlike traditional visual interpretation tools that only provide descriptions, MLLM-enabled applications offer conversational assistance, where users can ask questions to obtain goal-relevant details. However, evidence about their performance in the real-world and implications for BLV people’s daily lives remains limited. To address this, we conducted a two-week diary study, where we captured 20 BLV participants’ use of an MLLM-enabled visual interpretation application. Although participants rated the visual interpretations of the application as "trustworthy" (mean=3.76 out of 5, max=extremely trustworthy) and "somewhat satisfying" (mean=4.13 out of 5, max=very satisfying), the AI often produced incorrect answers (22.2\%) or abstained (10.8\%) from responding to users’ requests. Our findings show that while MLLMs can improve visual interpretations’ descriptive accuracy, supporting everyday use also depends on the “visual assistant” skill: behaviors for providing goal-directed, reliable assistance. We conclude by proposing the "visual assistant" skill and guidelines to help MLLM-enabled visual interpretation applications better support BLV people’s access to visual information.},
booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {1608},
numpages = {24},
keywords = {Accessibility, BLV, Blind People, Low Vision People, AI, Artificial Intelligence, LLM, Large language models, Diary Study, Conversations, MLLM, Multimodal models, VQA, Visual Question Answering},
location = {Barcelona, Spain},
series = {CHI '26}
}

@article{10.1145/3771567,
author = {Zhou, Yajie and Hsieh, Kevin and Mani, Sathiya Kumaran and Kandula, Srikanth and Liu, Zaoxing},
title = {MeshAgent: Enabling Reliable Network Management with Large Language Models},
year = {2025},
issue_date = {December 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {3},
url = {https://doi.org/10.1145/3771567},
doi = {10.1145/3771567},
abstract = {The emergence of large language models (LLMs) offers great promise for building domain-specific agents, but adapting them for network management remains challenging. To understand why, we conduct a case study on network management tasks and find that state-of-the-art specialization techniques rely heavily on extensive, high-quality task-specific data to produce precise solutions. However, real-world network queries are often diverse and unpredictable, making such techniques difficult to scale. Motivated by this gap, we propose MeshAgent, a new workflow that improves precision by extracting domain-specific invariants from sample queries and encoding them as constraints. These constraints guide LLM's generation and validation process, narrowing the search space and enabling low-effort adaptation. We evaluate our method across three network management applications and a user study involving industrial network professionals, showing that it complements existing techniques and consistently improves accuracy. We also introduce reliability metrics and demonstrate that our system is more dependable, with the ability to abstain when confidence is low. Overall, our results show that MeshAgent achieves over 95\% accuracy, reaching 100\% when paired with fine-tuned agents, and improves accuracy by up to 26\% compared to baseline methods. The extraction of reusable invariants provides a practical and scalable alternative to traditional LLM specialization, enabling the development of more reliable agents for real-world network management.},
journal = {Proc. ACM Meas. Anal. Comput. Syst.},
month = dec,
articleno = {52},
numpages = {36},
keywords = {agentic system reliability., large language models (llms) for networking}
}

