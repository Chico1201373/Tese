#!/usr/bin/env python3
"""
Metadados + texto completo (secção a secção) de artigos
(ScienceDirect, ACM DL, IEEE Xplore).

Uso:
  python papers.py -f urls.txt -o resumo.md
  python papers.py URL1 URL2 ... --pdf-dir pdfs
  python papers.py -f urls.txt --json -o resumo.json
  python papers.py -f urls.txt --no-fulltext        # só metadados + abstract

Cada linha do urls.txt:  URL [DOI] [ficheiro.pdf]
  Também aceita só o DOI ou um link doi.org.

Texto completo, por ordem:
  1. PDF local em --pdf-dir (default ./pdfs). O nome do ficheiro tem de conter
     o DOI (ex. 3746252.3761478), o nº IEEE (10706931) ou o PII (S2949719124000499),
     o que já acontece com os nomes originais dos sites. Ou indica o PDF na linha.
  2. arXiv (HTML estruturado), se existir versão.
  3. PDF open access (via OpenAlex).

Deps: pip install requests beautifulsoup4 pymupdf
"""
import argparse
import html
import json
import re
import sys
import time
import unicodedata
from collections import Counter
from pathlib import Path
from urllib.parse import quote, urlparse

import requests
from bs4 import BeautifulSoup

S = requests.Session()
S.headers.update({
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                  "(KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "Accept-Language": "en-US,en;q=0.9",
})

FIELDS = ["title", "authors", "venue", "year", "doi", "abstract", "keywords",
          "tldr", "citations", "pdf", "pdf_urls", "arxiv"]
ARXIV = re.compile(r"arxiv\.org/(?:abs|pdf|html)/(\d{4}\.\d{4,5}|[a-z\-]+/\d{7})", re.I)
LAST = {}  # url -> último estado HTTP / erro (diagnóstico)


# ---------- helpers ----------
def get(url, **kw):
    kw.setdefault("timeout", 20)
    try:
        r = S.get(url, **kw)
        LAST[url] = r.status_code
        return r if r.ok else None
    except requests.RequestException as e:
        LAST[url] = type(e).__name__
        return None


def jget(url, **kw):
    r = get(url, **kw)
    try:
        return r.json() if r else None
    except ValueError:
        return None


def clean(t):
    if not t:
        return None
    t = re.sub(r"<[^>]+>", " ", html.unescape(t))
    t = re.sub(r"\s+", " ", t).strip()
    t = re.sub(r"^abstract\b[:.\s]*", "", t, flags=re.I)
    return t or None


def norm_doi(d):
    if not d:
        return None
    return re.sub(r"^(https?://(dx\.)?doi\.org/|doi:\s*)", "", d.strip(), flags=re.I) or None


def first(xs):
    return xs[0] if xs else None


def tidy(t):
    t = re.sub(r"\s+", " ", t).strip()
    t = re.sub(r"\s+([.,;:)\]])", r"\1", t)
    return re.sub(r"([(\[])\s+", r"\1", t)


# ---------- identificar site ----------
def identify(url):
    if re.match(r"^10\.\d{4,9}/\S+$", url) or "doi.org/" in url:
        return "doi", {"doi": norm_doi(url)}
    u = urlparse(url)
    h, p = u.netloc.lower(), u.path
    if "sciencedirect.com" in h:
        m = re.search(r"/pii/([A-Za-z0-9]+)", p)
        return "sciencedirect", {"pii": m.group(1)} if m else {}
    if "dl.acm.org" in h:
        m = re.search(r"/doi/(?:abs/|full/|pdf/|epdf/)?(10\.\d+/[^?#]+)", p)
        return "acm", {"doi": m.group(1)} if m else {}
    if "ieeexplore.ieee.org" in h:
        m = re.search(r"/document/(\d+)", p)
        return "ieee", {"arnumber": m.group(1)} if m else {}
    raise ValueError("site não suportado (usa ScienceDirect, ACM ou IEEE Xplore)")


# ---------- metadados ----------
def from_page(url):
    if "ieeexplore" in url:
        get("https://ieeexplore.ieee.org/")  # cookies
        r = get(url, headers={"Referer": "https://ieeexplore.ieee.org/"})
    else:
        r = get(url)
    if not r:
        return {}
    soup = BeautifulSoup(r.text, "html.parser")

    def meta(*names):
        for n in names:
            v = [m["content"].strip()
                 for m in soup.find_all("meta", attrs={"name": re.compile(f"^{re.escape(n)}$", re.I)})
                 if m.get("content")]
            if v:
                return v
        return []

    date = first(meta("citation_publication_date", "citation_date", "dc.date")) or ""
    ym = re.search(r"\d{4}", date)
    kw = first(meta("citation_keywords")) or ""
    d = {
        "title": first(meta("citation_title", "dc.title")),
        "authors": meta("citation_author", "dc.creator"),
        "venue": first(meta("citation_journal_title", "citation_conference_title")),
        "year": ym.group(0) if ym else None,
        "doi": norm_doi(first(meta("citation_doi", "dc.identifier"))),
        "abstract": clean(first(meta("citation_abstract", "dc.description", "description"))),
        "keywords": [k.strip() for k in re.split(r"[;,]", kw) if k.strip()],
    }

    i = r.text.find("xplGlobal.document.metadata")  # IEEE: JSON embebido
    if i >= 0:
        j = r.text.find("{", i)
        try:
            x, _ = json.JSONDecoder().raw_decode(r.text[j:])
            d.update({k: v for k, v in {
                "title": x.get("title"),
                "abstract": clean(x.get("abstract")),
                "authors": [a["name"] for a in x.get("authors", []) if a.get("name")],
                "doi": norm_doi(x.get("doi")),
                "venue": x.get("publicationTitle"),
                "year": str(x.get("publicationYear") or "")[:4] or None,
                "keywords": [k for kw_ in x.get("keywords", []) for k in kw_.get("kwd", [])],
            }.items() if v})
        except ValueError:
            pass
    return {k: v for k, v in d.items() if v}


def from_crossref(doi=None, pii=None):
    w = None
    if doi:
        j = jget(f"https://api.crossref.org/works/{quote(doi, safe='/')}")
        w = (j or {}).get("message")
    elif pii:  # Elsevier regista o PII como alternative-id
        j = jget("https://api.crossref.org/works",
                 params={"filter": f"alternative-id:{pii}", "rows": 1})
        w = first(((j or {}).get("message") or {}).get("items") or [])
    if not w:
        return {}
    dp = first(first((w.get("issued") or {}).get("date-parts") or []) or [])
    return {k: v for k, v in {
        "title": clean(first(w.get("title") or [])),
        "authors": [" ".join(filter(None, [a.get("given"), a.get("family")]))
                    for a in w.get("author", [])],
        "venue": first(w.get("container-title") or []),
        "year": str(dp) if dp else None,
        "doi": norm_doi(w.get("DOI")),
        "abstract": clean(w.get("abstract")),
        "keywords": w.get("subject") or [],
    }.items() if v}


def uninvert(idx):
    if not idx:
        return None
    return " ".join(w for _, w in sorted((p, w) for w, ps in idx.items() for p in ps))


def from_openalex(doi=None, url=None):
    w = None
    if doi:
        w = jget(f"https://api.openalex.org/works/doi:{quote(doi, safe='/')}")
    elif url:
        j = jget("https://api.openalex.org/works",
                 params={"filter": f"locations.landing_page_url:{url}"})
        w = first((j or {}).get("results") or [])
    if not w or not w.get("title"):
        return {}
    src = (w.get("primary_location") or {}).get("source") or {}
    locs = [w.get("best_oa_location"), w.get("primary_location")] + (w.get("locations") or [])
    pdfs = [l["pdf_url"] for l in locs if l and l.get("pdf_url")]
    oa_url = (w.get("open_access") or {}).get("oa_url")
    if oa_url:
        pdfs.append(oa_url)
    return {k: v for k, v in {
        "title": w.get("title"),
        "authors": [a["author"]["display_name"] for a in w.get("authorships", [])
                    if a.get("author")],
        "venue": src.get("display_name"),
        "year": str(w.get("publication_year") or "") or None,
        "doi": norm_doi(w.get("doi")),
        "abstract": uninvert(w.get("abstract_inverted_index")),
        "keywords": [k["display_name"] for k in w.get("keywords", [])],
        "citations": w.get("cited_by_count"),
        "pdf": oa_url,
        "pdf_urls": list(dict.fromkeys(pdfs)),
    }.items() if v}


def from_s2(doi):
    j = jget(f"https://api.semanticscholar.org/graph/v1/paper/DOI:{quote(doi, safe='/')}",
             params={"fields": "title,abstract,tldr,year,venue,authors,citationCount,"
                               "openAccessPdf,externalIds"})
    if not j:
        return {}
    pdf = (j.get("openAccessPdf") or {}).get("url")
    return {k: v for k, v in {
        "title": j.get("title"),
        "authors": [a["name"] for a in j.get("authors", []) if a.get("name")],
        "venue": j.get("venue"),
        "year": str(j.get("year") or "") or None,
        "abstract": clean(j.get("abstract")),
        "tldr": (j.get("tldr") or {}).get("text"),
        "citations": j.get("citationCount"),
        "pdf": pdf,
        "pdf_urls": [pdf] if pdf else None,
        "arxiv": (j.get("externalIds") or {}).get("ArXiv"),
    }.items() if v}


# ---------- texto completo: PDF ----------
KNOWN = re.compile(
    r"^(abstract|introduction|background|related work|literature review|methodology|"
    r"methods?|materials and methods|approach|system (design|architecture)|implementation|"
    r"experiments?|experimental (setup|results)|evaluation|results( and discussion)?|"
    r"discussion|limitations|future work|conclusions?( and future work)?|"
    r"acknowledg(e)?ments?|references|bibliography|appendix.*)$", re.I)
NUM = re.compile(r"^(\d+(?:\.\d+){0,3}\.?|[IVX]{1,5}\.|[A-Z]\.)\s+(\S.{1,100})$")
REFS = re.compile(r"^(references|bibliography)$", re.I)


def _core(heading):
    m = NUM.match(heading or "")
    return (m.group(2) if m else heading or "").strip()


def _heading(t, size, emph, body, big):
    """(nível, texto) se a linha parecer título de secção, senão None."""
    t = t.strip()
    if not 3 <= len(t) <= 110 or t.endswith((",", ";")):
        return None
    m = NUM.match(t)
    core = m.group(2) if m else t
    strong = emph or size > body * 1.05
    if m and (strong or core.isupper()) and len(core.split()) <= 12 and not core.endswith("."):
        num = m.group(1).rstrip(".")
        if num[0].isdigit():
            lvl = num.count(".") + 1
        else:
            lvl = 1 if re.fullmatch(r"[IVX]+", num) else 2
        return min(lvl, 3), t
    if KNOWN.match(core) and strong and len(core.split()) <= 8:
        return 1, t
    if body * 1.15 <= size < big - 0.1 and len(t.split()) <= 12 and not t.endswith("."):
        return 1, t
    return None


def _join(lines):
    out = ""
    for l in lines:
        if out.endswith("-") and l[:1].islower():
            out = out[:-1] + l
        else:
            out += (" " if out else "") + l
    return tidy(out)


def pdf_sections(data):
    try:
        import fitz  # PyMuPDF
    except ImportError:
        raise RuntimeError("falta o pymupdf: pip install pymupdf")
    doc = fitz.open(stream=data, filetype="pdf")

    lines = []  # (texto, tamanho, ênfase, novo_bloco, na_margem)
    for page in doc:
        H = page.rect.height
        for b in page.get_text("dict")["blocks"]:
            if b.get("type") != 0:
                continue
            new = True
            for l in b["lines"]:
                spans = [s for s in l["spans"] if s["text"].strip()]
                if not spans:
                    continue
                text = unicodedata.normalize("NFKC", "".join(s["text"] for s in l["spans"])).strip()
                text = text.replace("\u00ad", "")
                size = round(max(s["size"] for s in spans), 1)
                emph = all((s["flags"] & 16) or (s["flags"] & 2) or "bold" in s["font"].lower()
                           for s in spans)
                y = l["bbox"][1] / H
                lines.append((text, size, emph, new, y < 0.07 or y > 0.93))
                new = False
    if not lines:
        raise RuntimeError("PDF sem texto (digitalizado?)")

    # remover cabeçalhos/rodapés e números de página (só na margem)
    n = len(doc)
    freq = Counter(t for t, _, _, _, mg in lines if mg and len(t) < 90)
    noise = {t for t, c in freq.items() if c >= max(2, n // 2)}
    lines = [x for x in lines
             if not (x[4] and (x[0] in noise or re.fullmatch(r"[\d\sivxIVX]{1,6}", x[0])))]

    sizes = Counter()
    for t, s, *_ in lines:
        sizes[s] += len(t)
    body = sizes.most_common(1)[0][0]
    big = max(s for _, s, *_ in lines)

    secs = []
    cur = {"level": 1, "heading": None, "size": body, "paras": []}
    for t, size, emph, new, _ in lines:
        hd = _heading(t, size, emph, body, big)
        if hd:
            if cur["heading"] and not cur["paras"] and not NUM.match(t) and abs(size - cur["size"]) < 0.3:
                cur["heading"] += " " + t  # título em 2 linhas
                continue
            secs.append(cur)
            cur = {"level": hd[0], "heading": hd[1], "size": size, "paras": []}
            continue
        if (cur["heading"] and not cur["paras"] and emph and len(t) < 80
                and abs(size - cur["size"]) < 0.3):
            cur["heading"] += " " + t
            continue
        if new or not cur["paras"]:
            cur["paras"].append([])
        cur["paras"][-1].append(t)
    secs.append(cur)

    out = []
    for s in secs:
        if s["heading"] is None or REFS.match(_core(s["heading"])):
            continue
        text = "\n\n".join(_join(p) for p in s["paras"])
        out.append({"level": s["level"], "heading": tidy(s["heading"]), "text": text})
    if not out:  # sem títulos detetados: devolve tudo como um bloco
        pre = [s for s in secs if s["heading"] is None]
        text = "\n\n".join(_join(p) for s in pre for p in s["paras"])
        out = [{"level": 1, "heading": "Texto (secções não detetadas)", "text": text}]
    return out


# ---------- texto completo: arXiv HTML ----------
def arxiv_sections(aid):
    r = get(f"https://arxiv.org/html/{aid}", timeout=40)
    if not r:
        return None
    soup = BeautifulSoup(r.text, "html.parser")
    for m in soup.find_all("math"):
        m.replace_with(f" {m.get('alttext', '')} ")
    out = []
    for sec in soup.find_all("section", class_=re.compile(r"^ltx_(sub)*section$|^ltx_appendix$")):
        h = sec.find(re.compile(r"^h[2-6]$"), recursive=False)
        if not h:
            continue
        heading = tidy(h.get_text(" ", strip=True))
        if REFS.match(_core(heading)):
            continue
        paras = [tidy(p.get_text(" ", strip=True))
                 for p in sec.find_all("div", class_="ltx_para", recursive=False)]
        cls = " ".join(sec.get("class", []))
        lvl = 3 if "subsubsection" in cls else 2 if "subsection" in cls else 1
        out.append({"level": lvl, "heading": heading, "text": "\n\n".join(p for p in paras if p)})
    return out if len(out) >= 2 else None


# ---------- texto completo: escolher fonte ----------
def find_local(pdf_dir, keys):
    keys = [k.lower() for k in keys if k and len(k) >= 6]
    if not pdf_dir or not keys or not Path(pdf_dir).is_dir():
        return None
    for f in sorted(Path(pdf_dir).glob("*.pdf")):
        if any(k in f.name.lower() for k in keys):
            return f
    return None


def fulltext(p, ids, pdf=None, pdf_dir=None):
    doi = p.get("doi")
    keys = [ids.get("pii"), ids.get("arnumber"),
            doi.split("/", 1)[1] if doi and "/" in doi else None,
            doi.replace("/", "_") if doi else None]
    local = Path(pdf) if pdf else find_local(pdf_dir, keys)
    if local:
        if not local.is_file():
            raise RuntimeError(f"PDF não encontrado: {local}")
        return pdf_sections(local.read_bytes()), f"PDF local ({local.name})"

    if p.get("arxiv"):
        s = arxiv_sections(p["arxiv"])
        if s:
            return s, f"arXiv HTML ({p['arxiv']})"

    for u in p.get("pdf_urls") or []:
        r = get(u, timeout=60)
        if r and r.content[:5] == b"%PDF-":
            try:
                return pdf_sections(r.content), f"PDF open access ({u})"
            except RuntimeError:
                continue
    return None, None


# ---------- pipeline ----------
def merge(*srcs):
    out = {}
    for f in FIELDS:
        vals = [s[f] for s in srcs if s.get(f)]
        if not vals:
            continue
        if f == "abstract":
            out[f] = max(vals, key=len)
        elif f == "pdf_urls":
            out[f] = list(dict.fromkeys(u for v in vals for u in v))
        else:
            out[f] = vals[0]
    return out


def process(url, doi_override=None, pdf=None, pdf_dir=None, full=True):
    kind, ids = identify(url)
    if kind == "doi":
        url, page = f"https://doi.org/{ids['doi']}", {}
    else:
        page = from_page(url)
        if not page:
            print(f"   página não lida (HTTP {LAST.get(url)})", file=sys.stderr)
    doi = norm_doi(doi_override or page.get("doi") or ids.get("doi"))

    cr = from_crossref(doi=doi, pii=None if doi else ids.get("pii"))
    doi = doi or cr.get("doi")
    oa = from_openalex(doi=doi, url=None if doi else url)
    doi = doi or oa.get("doi")
    s2 = from_s2(doi) if doi else {}

    r = merge(page, cr, oa, s2)
    if not r.get("title"):
        raise RuntimeError("sem dados: página bloqueada e DOI não resolvido "
                           "(põe o DOI a seguir ao URL: 'URL 10.xxxx/yyyy')")
    r.update(doi=doi, url=url, source=kind)

    if not r.get("arxiv"):
        for u in (r.get("pdf_urls") or []):
            m = ARXIV.search(u)
            if m:
                r["arxiv"] = m.group(1)
                break

    if full:
        secs, src = fulltext(r, ids, pdf, pdf_dir)
        if secs:
            r["sections"], r["fulltext_source"] = secs, src
            print(f"   texto completo: {src} — {len(secs)} secções", file=sys.stderr)
        else:
            print("   sem texto completo: descarrega o PDF para a pasta pdfs/", file=sys.stderr)
    return r


# ---------- output ----------
def to_md(p):
    au = p.get("authors") or []
    au_s = ", ".join(au[:6]) + (" et al." if len(au) > 6 else "")
    head = " · ".join(filter(None, [p.get("venue"), p.get("year")]))
    L = [f"## {p['title']}", ""]
    if au_s:
        L.append(f"**Autores:** {au_s}  ")
    if head:
        L.append(f"**Publicação:** {head}  ")
    if p.get("doi"):
        L.append(f"**DOI:** https://doi.org/{p['doi']}  ")
    L.append(f"**Fonte:** {p['source']} — {p['url']}  ")
    if p.get("citations") is not None:
        L.append(f"**Citações:** {p['citations']}  ")
    if p.get("keywords"):
        L.append(f"**Keywords:** {', '.join(p['keywords'])}  ")
    if p.get("tldr"):
        L += ["", f"**TL;DR:** {p['tldr']}"]
    if p.get("abstract"):
        L += ["", "**Abstract:**", "", p["abstract"]]
    if p.get("sections"):
        L += ["", f"**Texto completo** — {p['fulltext_source']}"]
        for s in p["sections"]:
            L += ["", "#" * (2 + s["level"]) + " " + s["heading"]]
            if s["text"]:
                L += ["", s["text"]]
    elif "sections" not in p:
        pass
    return "\n".join(L) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("urls", nargs="*")
    ap.add_argument("-f", "--file", help="ficheiro com um URL por linha")
    ap.add_argument("-o", "--out", help="ficheiro de saída (default: stdout)")
    ap.add_argument("--json", action="store_true", help="saída em JSON")
    ap.add_argument("--pdf-dir", default="pdfs", help="pasta com PDFs locais (default: pdfs)")
    ap.add_argument("--no-fulltext", action="store_true", help="só metadados + abstract")
    a = ap.parse_args()

    urls = list(a.urls)
    if a.file:
        with open(a.file, encoding="utf-8") as fh:
            urls += [l.strip() for l in fh if l.strip() and not l.startswith("#")]
    if not urls and not sys.stdin.isatty():
        urls += [l.strip() for l in sys.stdin if l.strip()]
    urls = list(dict.fromkeys(urls))
    if not urls:
        ap.error("indica pelo menos um URL")

    entries = []  # (url, doi, pdf)
    for raw in urls:
        p = raw.split()
        doi = pdf = None
        for t in p[1:]:
            if t.lower().endswith(".pdf"):
                pdf = t
            else:
                doi = t
        entries.append((p[0], doi, pdf))

    results, errors = [], []
    for n, (u, d, pdf) in enumerate(entries, 1):
        print(f"[{n}/{len(entries)}] {u}", file=sys.stderr)
        try:
            results.append(process(u, d, pdf, a.pdf_dir, not a.no_fulltext))
        except Exception as e:  # noqa: BLE001
            errors.append({"url": u, "error": str(e)})
            print(f"   ! {e}", file=sys.stderr)
        time.sleep(1)

    if a.json:
        text = json.dumps({"papers": results, "errors": errors}, ensure_ascii=False, indent=2)
    else:
        text = "# Resumo de artigos\n\n" + "\n---\n\n".join(to_md(p) for p in results)
        if errors:
            text += "\n---\n\n## Falhas\n\n" + "\n".join(f"- {e['url']} — {e['error']}" for e in errors)

    if a.out:
        with open(a.out, "w", encoding="utf-8") as fh:
            fh.write(text)
        print(f"Guardado em {a.out}", file=sys.stderr)
    else:
        print(text)


if __name__ == "__main__":
    main()